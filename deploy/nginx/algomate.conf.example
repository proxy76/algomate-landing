# nginx config for algomate.ro
#
# Reconciled against the live config on 2026-08-21 (`nginx -T`) — the whole
# file below is the real one, not a template. Public TLS is terminated by a
# Cloudflare tunnel, which forwards to nginx on 127.0.0.1:8080.
#
# Everything here is APPLIED. This file is a reference for what the live
# config is and why, not a change to make.
#
# ─── WHY THESE DIRECTIVES EXIST — do not "simplify" them ────────────────────
#
# The docroot is the atomic-deploy symlink, swapped by rebuild.sh:
#
#     root /srv/algomate-deploy/current;   # NOT frontend/dist
#
# Pointing it back at a directory that a build writes into re-creates the
# outage of 2026-08-15 (see docs/SERVER-SETUP.md §5.2).
#
# The `location /` block once read `try_files $uri $uri/ /index.html;`, and
# that single line caused both indexing bugs (§4.3.1, §4.3.2):
#
#   $uri/       matches the directory, so nginx answered /blog with a 301 to
#               http://algomate.ro:8080/blog/ — it builds the Location from its
#               own scheme and listening port, having no idea the public origin
#               is https on 443 behind the tunnel. Google then saw a sitemap
#               URL that redirects to a page whose canonical points back at the
#               redirecting URL, which is a standard reason to index neither.
#
#   /index.html is an SPA fallback: every unknown URL returned 200 with the
#               homepage byte-for-byte. /wp-login.php included. Google reads
#               that as a soft 404.
#
# The current form serves /blog straight from /blog/index.html as a 200 — no
# redirect at all, so the fetched URL matches the canonical the page prints —
# and 404s anything with no file behind it. The site is fully prerendered, so
# there is nothing an SPA fallback needs to do. `absolute_redirect off` and
# `port_in_redirect off` keep any redirect nginx does emit relative, which is
# what stops the :8080 leak recurring in the retired-slug block.
#
# After any change here: sudo nginx -t && sudo systemctl reload nginx, then
# node frontend/scripts/check-live-seo.mjs https://algomate.ro

server {
    listen 127.0.0.1:8080;
    server_name algomate.ro;

    client_max_body_size 1m;

    # Frontend — prerendered static output, not an SPA
    root /srv/algomate-deploy/current;
    index index.html;

    # nginx is not the public origin (TLS terminates at the Cloudflare tunnel);
    # never let it name a scheme, host or port in a redirect.
    absolute_redirect off;
    port_in_redirect  off;

    # Retired slugs — 301 to the current URL so the old one does not 404.
    # Relative targets only; absolute_redirect off keeps them relative (§4.3.1).
    location = /blog/rezolvare-bac-2026-matematica-tehnologic-varianta-4 {
        return 301 /blog/rezolvare-subiect-mate-bac-m2-august-2026;
    }

    location / {
        try_files $uri $uri/index.html =404;
    }

    # Django API. The enrollment form posts here; if this proxy stops
    # working the form breaks silently. A GET returns 405 (POST-only), which
    # is the quick check that it is intact — 502/504 means it is not.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
