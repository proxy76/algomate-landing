# nginx config for algomate.ro
#
# Reconciled against the live config on 2026-08-15 (`nginx -T`), so the
# surrounding directives here are the real ones, not guesses. Public TLS is
# terminated by a Cloudflare tunnel, which forwards to nginx on 127.0.0.1:8080.
#
# Only the `location /` block and the two redirect directives change. Verify
# the listen line and any directives above server_name against the live file
# before applying — the capture used to write this started at server_name.

# ─── WHAT CHANGES ───────────────────────────────────────────────────────────
#
#   -    location / {
#   -        try_files $uri $uri/ /index.html;
#   -    }
#   +    absolute_redirect off;
#   +    port_in_redirect  off;
#   +
#   +    location / {
#   +        try_files $uri $uri/index.html =404;
#   +    }
#
# That single old line caused both production bugs:
#
#   $uri/       matches the directory, so nginx answers /blog with a 301 to
#               http://algomate.ro:8080/blog/ — it builds the Location from its
#               own scheme and listening port, having no idea the public origin
#               is https on 443 behind the tunnel. Google then sees a sitemap
#               URL that redirects to a page whose canonical points back at the
#               redirecting URL, which is a standard reason to index neither.
#
#   /index.html is an SPA fallback: every unknown URL returned 200 with the
#               homepage byte-for-byte. /wp-login.php included. Google reads
#               that as a soft 404.
#
# The replacement serves /blog straight from /blog/index.html as a 200 — no
# redirect at all, so the fetched URL matches the canonical the page prints —
# and 404s anything with no file behind it. The site is fully prerendered, so
# there is nothing an SPA fallback needs to do.

server {
    listen 127.0.0.1:8080;
    server_name algomate.ro;

    client_max_body_size 1m;

    # Frontend — prerendered static output, not an SPA
    root /srv/algomate/frontend/dist;
    index index.html;

    # nginx is not the public origin; never let it name a scheme, host or port.
    absolute_redirect off;
    port_in_redirect  off;

    location / {
        try_files $uri $uri/index.html =404;
    }

    # Django API — unchanged from the live config. The enrollment form posts
    # here; if this stops working the form silently breaks.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# ─── APPLY ──────────────────────────────────────────────────────────────────
#
#   sudo cp /etc/nginx/sites-available/algomate /root/algomate.nginx.bak
#   sudo nano /etc/nginx/sites-available/algomate     # make the change above
#   sudo nginx -t && sudo systemctl reload nginx
#
# ─── VERIFY ─────────────────────────────────────────────────────────────────
#
#   node frontend/scripts/check-live-seo.mjs https://algomate.ro
#
# Baseline before the fix is 16 failures; after it should be 0. Then test the
# enrollment form by hand — the script does not touch /api/.
#
# Roll back with:
#   sudo cp /root/algomate.nginx.bak /etc/nginx/sites-available/algomate
#   sudo nginx -t && sudo systemctl reload nginx
#
# ─── NOT CHANGED HERE, ON PURPOSE ───────────────────────────────────────────
#
# Cache headers for /assets/ (fingerprinted by Vite, so cacheable forever) and
# a short max-age for .html would both help, but they are a separate change
# with separate failure modes. Get indexing correct first.
