# Copy to backend/.env and fill in. The real file holds the Django secret and
# a Gmail app password, so it must be readable by the service user only:
#
#     chmod 600 backend/.env
#
# Never commit it (backend/.gitignore covers .env and .env.*).

# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=algomate.ro
CORS_ALLOWED_ORIGINS=https://algomate.ro

# Gmail account the notification is sent from, and its *app password*
# (Google Account → Security → 2-Step Verification → App passwords).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Where enrolment requests are delivered. Defaults to EMAIL_HOST_USER.
CONTACT_RECIPIENT_EMAIL=
